# Copy to `.env.local` for local development. Never commit real values.
# Everything prefixed EXPO_PUBLIC_ is bundled into the APK and is readable by anyone
# with the app — do not put API keys, JWT secrets or provider credentials here.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Updata API base including the /api/v1 prefix (same value as the web client's NEXT_PUBLIC_API_URL).
# Android emulator → your machine's localhost is 10.0.2.2. Staging/production must be https.
EXPO_PUBLIC_API_URL=http://10.0.2.2:9097/api/v1

# Redacted request logging in the Metro console. Ignored in production.
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=true
