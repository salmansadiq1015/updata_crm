# Example nginx config for HTTPS deployment on EC2.
# Mixed content is blocked when https://appnity.ch embeds http://YOUR_IP:3000 —
# terminate TLS here and point the parent iframe at https://YOUR_DOMAIN/ (not http://...:3000).
#
# 1. Point a domain (e.g. boiler.appnity.ch) to your server IP.
# 2. sudo certbot --nginx -d boiler.appnity.ch
# 3. Parent app iframe: src="https://boiler.appnity.ch/" (HTTPS required)

upstream boiler_client {
  server 127.0.0.1:3000;
}

upstream boiler_api {
  server 127.0.0.1:9097;
}

server {
  listen 80;
  server_name boiler.appnity.ch;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name boiler.appnity.ch;

  # certbot fills these paths:
  # ssl_certificate /etc/letsencrypt/live/boiler.appnity.ch/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/boiler.appnity.ch/privkey.pem;

  client_max_body_size 50m;

  location /socket.io/ {
    proxy_pass http://boiler_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    proxy_pass http://boiler_api;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://boiler_client;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
