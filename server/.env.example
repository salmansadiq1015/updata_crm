# ============================================
# Updata - Environment Config
# ============================================
# Copy to .env and fill in values.
# NEVER commit .env to version control.

# --- Server ---
NODE_ENV=development
PORT=9097
HOST=0.0.0.0
USE_CLUSTER=false
WORKERS=4

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/updata

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=mb:

# --- JWT / Auth ---
# MUST be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=updata-api
SESSION_SECRET=change-me-to-another-secret-16plus
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOCKOUT_DURATION_SECONDS=1800
ACTIVATION_TOKEN_EXPIRY_HOURS=24
SESSION_MAX_PER_USER=5

# --- Admin Seeding ---
ADMIN_EMAIL=admin@updata.ai
ADMIN_PASSWORD=change-me-strong-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# --- Client ---
CLIENT_URI=http://localhost:3000
# Comma-separated allowed origins for CORS (production)
# Include HTTPS parent app when embedded in appnity.ch iframe:
# ALLOWED_ORIGINS=https://updata.ai,https://www.updata.ai,https://app.updata.ai
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_MAIL=
SMTP_PASSWORD=
SUPPORT_EMAIL=support@example.ch

# --- Cloud Storage (AWS S3) ---
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=eu-central-1
# Leave empty for AWS S3. For MinIO/local only: AWS_S3_ENDPOINT=http://localhost:9000
# Do NOT set a bare hostname (e.g. s3.amazonaws.com) or whitespace — that causes upload failures.
AWS_S3_ENDPOINT=
STORAGE_MAX_FILE_SIZE=52428800
STORAGE_PRESIGN_EXPIRY=900

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=5
RATE_LIMIT_UPLOAD=10

# --- Logging & Observability ---
LOG_LEVEL=info
SENTRY_DSN=

# --- BullMQ ---
BULLMQ_PREFIX=bull

# --- Audit ---
AUDIT_RETENTION_DAYS=365

# --- Auto Migration ---
AUTO_MIGRATE=false

# ============================================
# AI Assistant (Module 07)
# ============================================

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000
# Provider for every AI call. Infomaniak is OpenAI-compatible and hosted in
# Switzerland; leave OPENAI_BASE_URL empty to use OpenAI directly.
#   Infomaniak : OPENAI_BASE_URL=https://api.infomaniak.com/2/ai/<product_id>/openai/v1
#                OPENAI_MODEL=qwen3   (also: mistral24b, mistral3)
#                OPENAI_API_KEY=<Infomaniak API token>
# Note: response_format json_object is OpenAI-only and is skipped automatically
# when OPENAI_BASE_URL is set. Embeddings are not yet available on Infomaniak.
OPENAI_BASE_URL=

# --- STT Provider (whisper | google | azure) ---
# On Infomaniak the audio endpoint is derived automatically from
# OPENAI_BASE_URL, but it is NOT the same path as the chat endpoint: audio
# lives under /1/ai/<product>/openai, the model is called "whisper" (not
# "whisper-1"), the call is asynchronous, and word timestamps are not offered.
STT_PROVIDER=whisper

# --- Google Cloud STT (optional, if STT_PROVIDER=google) ---
# GOOGLE_STT_API_KEY=
# GOOGLE_STT_PROJECT_ID=

# --- Azure Speech (optional, if STT_PROVIDER=azure) ---
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# ============================================
# Notifications (Module 13)
# ============================================

# --- Push Notifications (OneSignal) ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Notification Webhook Secrets (HMAC verification) ---
NOTIFICATION_EMAIL_WEBHOOK_SECRET=
NOTIFICATION_WHATSAPP_WEBHOOK_SECRET=

# ============================================
# Integrations (Module 14)
# ============================================

# --- WhatsApp Business API ---
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=

# --- SMS Gateway ---
SMS_API_KEY=

# --- Google Calendar OAuth ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:9097/api/v1/users/me/calendar/callback

# --- Google Maps Platform (Business Discovery / Lead Generation) ---
# All keys below are OPTIONAL: the API boots without them and the discovery
# module reports "not configured" until GOOGLE_PLACES_API_KEY is set.
# The Google Cloud project needs billing enabled. Enable these APIs
# (Google Cloud Console > APIs & Services > Library):
#   - Places API (New)     nearby/text search and place details (server key)
#   - Geocoding API        resolving typed locations to coordinates (server key)
#   - Maps JavaScript API  map, area drawing and autocomplete in the UI (browser key)
#
# Server key - SECRET. Used only by the API: never sent to the browser, never
# logged, never committed. Restrict it twice in Google Cloud Console: by IP
# address (the API server's outbound IPs) and by API (Places API (New) and
# Geocoding API only).
GOOGLE_PLACES_API_KEY=
# Optional dedicated Geocoding key. Leave empty to reuse GOOGLE_PLACES_API_KEY.
GOOGLE_GEOCODING_API_KEY=
# Browser key - public by design (it ships to the browser), so it MUST be
# restricted by HTTP referrer (e.g. https://app.updata.ai/* and
# http://localhost:3000/*) and by API (Maps JavaScript API only; add Places
# API (New) only if the UI uses client-side Autocomplete). The Next.js client
# uses the same key as NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY in client/.env.local.
GOOGLE_MAPS_BROWSER_KEY=

# --- Business Discovery limits (cost controls, applied per search session) ---
# Every run is bounded so one search can never turn into an open-ended paid loop.
# Also set budget alerts and API quotas in Google Cloud Console.
# Maximum businesses collected per session (1-5000).
DISCOVERY_MAX_RESULTS=500
# Maximum paid Google search calls per session (1-500).
DISCOVERY_MAX_SEARCH_REQUESTS=40
# Maximum search regions a large area is split into (1-500). Each region needs
# at least one search call, so DISCOVERY_MAX_SEARCH_REQUESTS also caps this.
DISCOVERY_MAX_COVERAGE_CELLS=50
# Parallel Google calls per discovery run (1-10).
DISCOVERY_CONCURRENCY=3
# Days a discovery session and its results are kept before automatic deletion
# (1-365). Google limits how long place data may be stored: keep this short.
DISCOVERY_RESULT_TTL_DAYS=60

# --- Website enrichment (responsible scraper for lead contact fields) ---
# Fills MISSING lead email / phone / social links from the lead's own website
# over plain HTTP. robots.txt is honoured and every fetch is bounded.
# Per-request HTTP timeout in ms (1000-60000).
ENRICHMENT_TIMEOUT_MS=8000
# Maximum response size per page in bytes (download aborts beyond this).
ENRICHMENT_MAX_BYTES=1500000
# Parallel sites scraped per bulk enrichment job (1-10).
ENRICHMENT_CONCURRENCY=3
# Honour robots.txt Disallow rules (true in production; set false only for tests).
ENRICHMENT_RESPECT_ROBOTS=true
# Polite, self-identifying User-Agent sent on every enrichment request.
ENRICHMENT_USER_AGENT=UpdataCRM-Enrichment/1.0

# --- Microsoft Outlook Calendar OAuth ---
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:9097/api/v1/users/me/calendar/callback

# --- OCR Service ---
# OCR_PROVIDER=google_document_ai
# OCR_API_KEY=
# OCR_ENDPOINT=

# --- Widget reCAPTCHA ---
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# ============================================
# Legacy / Payment (not used by ERP modules)
# ============================================

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- APK Distribution ---
APK_SERVER_URL=http://179.237.101.32:8005/apk-mb
APK_UPLOAD_SECRET=

# ============================================
# Production Overrides (uncomment for production)
# ============================================
# NODE_ENV=production
# USE_CLUSTER=true
# WORKERS=4
# LOG_LEVEL=warn
