{
  "manifest_version": 3,
  "name": "Lead Finder — Local Maps Discovery",
  "version": "0.5.0",
  "key": "",
  "description": "A local-first assistant for collecting business details exposed in your Google Maps research session.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "downloads", "sidePanel", "activeTab", "scripting", "alarms"],
  "host_permissions": [
    "https://updata.behjja.com/*",
    "https://www.google.com/maps/*",
    "https://maps.google.com/*",
    "https://*.google.com/maps/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "externally_connectable": {
    "matches": ["https://updata.behjja.com/*", "https://updata-crm.vercel.app/*", "http://localhost:3000/*", "http://localhost:9097/*"]
  },
  "action": {
    "default_title": "Open Lead Finder"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*",
        "https://*.google.com/maps/*"
      ],
      "js": ["content/maps.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-lead-finder": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Open Lead Finder side panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
