# ─────────────────────────────────────────────────────────────
#  MODÈLE — copier en .env.local et adapter :
#      cp server/.env.local.example server/.env.local
#
#  Ce que CETTE machine est. Chargé après .env, et le remplace.
#  .env.local n'est jamais commité ; ce modèle-ci l'est.
#
#  Ne mettre ici que ce qui est propre au poste : les adresses des
#  services locaux. Les secrets partagés restent dans .env.
# ─────────────────────────────────────────────────────────────

# --- Base de travail locale (Mongo Homebrew, replica set rs0, sans auth) ---
MONGODB_URI=mongodb://localhost:27017/mb_boiler

# --- Redis local (Homebrew) ---
REDIS_URL=redis://127.0.0.1:6379

# --- MinIO local : bucket S3-compatible sur cette machine ---
STORAGE_BACKEND=minio
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET_NAME=mbboiler

# --- Front-end local ---
# Sert uniquement à construire les liens dans les e-mails d'activation et de
# réinitialisation. Décommenter pour tester ces parcours en local, et mettre
# le port sur lequel le client tourne réellement (3000 par défaut).
# CLIENT_URI=http://localhost:3000
