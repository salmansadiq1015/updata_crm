# ============================================
# Updata - Environment Config
# ============================================
# Copy to .env and fill in values.
# NEVER commit .env to version control.

# --- Server ---
NODE_ENV=development
PORT=9097
HOST=0.0.0.0
USE_CLUSTER=false
WORKERS=4

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/updata
# Retry transient startup failures before exiting; authentication errors fail immediately.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_ATTEMPTS=3
MONGODB_CONNECT_RETRY_DELAY_MS=2000

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=mb:

# --- JWT / Auth ---
# MUST be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=updata-api
SESSION_SECRET=change-me-to-another-secret-16plus
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_SECONDS=900
AUTH_LOCKOUT_DURATION_SECONDS=1800
ACTIVATION_TOKEN_EXPIRY_HOURS=24
SESSION_MAX_PER_USER=5

# --- Admin Seeding ---
ADMIN_EMAIL=admin@updata.ai
ADMIN_PASSWORD=change-me-strong-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# --- Client ---
COMPANY_NAME=Updata.ai
CLIENT_URI=http://localhost:3000
# Comma-separated allowed origins for CORS (production)
# Include HTTPS parent app when embedded in appnity.ch iframe:
# The release manifest pins this exact extension origin. Never use a wildcard
# for extension origins.
# ALLOWED_ORIGINS=https://updata.ai,https://www.updata.ai,https://app.updata.ai,chrome-extension://bnmjibohjdkkibimeknikhnolhlbgmnk
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_FROM_NAME=Updata.ai
SMTP_MAIL=
SMTP_PASSWORD=
# Nodemailer connection-pool limits.
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
# Keep true in production. Set false only for an explicitly trusted private
# SMTP server using a self-signed certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=true
SUPPORT_EMAIL=support@example.ch

# --- Lead multi-channel messaging ---
# A stable random secret used only to hash destinations in suppression records.
MESSAGE_DESTINATION_HASH_SECRET=
# A separate HMAC secret for signed public unsubscribe links.
MESSAGE_UNSUBSCRIBE_SECRET=
# Externally reachable API origin, e.g. https://api.example.com (no trailing slash).
MESSAGING_PUBLIC_API_URL=
MESSAGING_CONCURRENCY=3
# Outbound SMS/WhatsApp/email pace across all workers (messages per minute)
MESSAGING_RATE_PER_MINUTE=30
# Conservative crash recovery: queued work is re-enqueued, but a submission
# that may have reached a provider is marked unknown for reconciliation.
MESSAGING_RECOVERY_STALE_MINUTES=10
MESSAGING_RECOVERY_BATCH_SIZE=500
# Bounded polling supplements signed webhooks for accepted TextBee/Twilio IDs.
# It never retries an ambiguous submission that lacks a provider ID.
MESSAGING_RECONCILIATION_MIN_AGE_MINUTES=5
MESSAGING_RECONCILIATION_MAX_AGE_DAYS=7
MESSAGING_RECONCILIATION_BATCH_SIZE=200
# Optional deployment-preflight overrides. The bearer token must be a current,
# short-lived token belonging to a user with settings:read permission.
MESSAGING_PREFLIGHT_API_URL=
MESSAGING_PREFLIGHT_BEARER_TOKEN=

# Meta WhatsApp Cloud API. Keep tokens server-side. Set the Graph version used
# by the Meta app after checking its supported/current version before deploy.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_WHATSAPP_TIMEOUT_MS=15000

# TextBee Android/SIM gateway (primary SMS provider).
TEXTBEE_API_KEY=
# Optional for sending; required for exact batch reconciliation polling.
TEXTBEE_DEVICE_ID=
TEXTBEE_API_URL=https://api.textbee.dev
# At least 20 characters; must match the TextBee webhook subscription.
TEXTBEE_WEBHOOK_SECRET=
TEXTBEE_TIMEOUT_MS=15000

# Twilio Messaging API (optional SMS fallback/direct route).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=
# Exact externally visible callback URL, used for signature verification.
TWILIO_WEBHOOK_PUBLIC_URL=
TWILIO_TIMEOUT_MS=15000

# --- Cloud Storage (AWS S3) ---
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=eu-central-1
# Leave empty for AWS S3. For MinIO/local only: AWS_S3_ENDPOINT=http://localhost:9000
# Do NOT set a bare hostname (e.g. s3.amazonaws.com) or whitespace — that causes upload failures.
AWS_S3_ENDPOINT=
STORAGE_MAX_FILE_SIZE=52428800
STORAGE_PRESIGN_EXPIRY=900

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=5
RATE_LIMIT_UPLOAD=10

# --- Logging & Observability ---
LOG_LEVEL=info
SENTRY_DSN=

# --- BullMQ ---
BULLMQ_PREFIX=bull

# --- Audit ---
AUDIT_RETENTION_DAYS=365

# --- Auto Migration ---
AUTO_MIGRATE=false

# ============================================
# AI Assistant (Module 07)
# ============================================

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000
# Provider for every AI call. Infomaniak is OpenAI-compatible and hosted in
# Switzerland; leave OPENAI_BASE_URL empty to use OpenAI directly.
#   Infomaniak : OPENAI_BASE_URL=https://api.infomaniak.com/2/ai/<product_id>/openai/v1
#                OPENAI_MODEL=qwen3   (also: mistral24b, mistral3)
#                OPENAI_API_KEY=<Infomaniak API token>
# Note: response_format json_object is OpenAI-only and is skipped automatically
# when OPENAI_BASE_URL is set. Embeddings are not yet available on Infomaniak.
OPENAI_BASE_URL=

# --- AI Voice Calling (OpenAI Realtime + LiveKit Agents + SIP) ---------------
# All blank by default: the feature then reports "not configured" and NEVER
# fabricates a PSTN call. The browser Simulate console works without any of these.
# Base URL the LiveKit agent worker can reach to call back into this API.
# REQUIRED (https) in production: without it real dials are refused and the
# campaign is paused, because the agent could not reach the CRM (silent call).
PUBLIC_API_BASE_URL=
# How many campaign "tick" jobs run in parallel (not calls — concurrency is per
# campaign via schedule.maxConcurrency).
AI_CALLING_WORKER_CONCURRENCY=5
# Secrets for per-call agent tokens and phone-number hashing (fall back to JWT_SECRET).
# IMPORTANT: the do-not-call list is keyed by HMAC(AI_CALLING_PHONE_HASH_SECRET).
# Changing it (or rotating JWT_SECRET while this is blank) silently detaches every
# existing suppression and consent record. Set it explicitly in production and
# never rotate it without re-hashing (if blank today, set it to the CURRENT
# JWT_SECRET value so existing hashes stay valid).
AI_CALLING_AGENT_SECRET=
# Paired-phone calling (owner's Android phone + SIM via the ESP32 Bluetooth gateway).
# Encrypts the ESP32 dial keys at rest (falls back to JWT_SECRET; required in production).
PAIRED_PHONE_KEY_SECRET=
# Global AI voice kill switch: set to false to stop every voice campaign from dialing.
AI_VOICE_CALLING_ENABLED=true
AI_CALLING_PHONE_HASH_SECRET=
AI_CALLING_REQUIRE_CONSENT=true
# Recipient-local quiet hours, applied in the LEAD's country timezone on top of
# the campaign window (single-timezone countries only). Conservative defaults —
# NOT legal advice; verify the rules for every country you call.
AI_CALLING_RECIPIENT_HOURS=08:00-20:00
AI_CALLING_RECIPIENT_DAYS=1,2,3,4,5,6      # 0=Sun … 6=Sat
# Optional blended cost estimate per billed minute (realtime model + carrier),
# used for campaign cost and schedule.maxCampaignSpend when the provider reports
# no amount. Blank/0 = no estimate (cost stays 0; prices are never invented).
AI_CALLING_COST_PER_MINUTE=
AI_CALLING_COST_CURRENCY=USD
# Per-call cost analytics. Realtime-model tokens are priced at OpenAI list rates automatically;
# add your carrier's per-minute rate (cloud SIP only) and LiveKit agent-minute rate to include them.
# Override model rates (USD per 1M tokens) with JSON, e.g. {"gpt-realtime":{"audioIn":32,"audioOut":64}}
AI_CALLING_TELEPHONY_COST_PER_MINUTE=
AI_CALLING_PLATFORM_COST_PER_MINUTE=
AI_CALLING_MODEL_PRICING=
# Quality dashboard: a call whose p95 response latency (end of caller speech -> first agent audio) exceeds this is flagged. Default 2000.
AI_CALLING_QUALITY_LATENCY_MS=2000
# OpenAI Realtime model/voice used by the agent worker.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
# LiveKit project (same project the worker connects to).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=crm-voice-agent
LIVEKIT_TIMEOUT_MS=15000
#
# Outbound PHONE (PSTN) calling needs a SIP trunk. Two options (carrier-agnostic,
# NOT Twilio — use Telnyx, Plivo, Vonage, or a Swiss carrier like Peoplefone/Sipcall):
#
#  A) Pre-made trunk: create an outbound trunk in the LiveKit dashboard pointing at
#     your carrier, then set just its id here:
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
#
#  B) Bring-your-own carrier: give the carrier's SIP creds and the CRM auto-creates
#     the LiveKit outbound trunk for you (idempotent). Leave (A) blank to use this.
SIP_OUTBOUND_ADDRESS=            # carrier SIP host, e.g. sip.telnyx.com / sip.peoplefone.ch
SIP_OUTBOUND_NUMBER=             # your DID / caller-ID in E.164, e.g. +41445001234
SIP_OUTBOUND_USERNAME=           # SIP auth username (blank for IP-authenticated trunks)
SIP_OUTBOUND_PASSWORD=           # SIP auth password
SIP_OUTBOUND_TRANSPORT=auto      # auto | udp | tcp | tls
SIP_OUTBOUND_TRUNK_NAME=crm-outbound
#
# Optional caller-ID override (else SIP_OUTBOUND_NUMBER is used):
LIVEKIT_SIP_CALLER_ID=

# Optional fallback only. This must be a separate LiveKit outbound trunk that
# routes through Twilio; it is never selected as the primary carrier. Restrict
# countries with comma-separated ISO-2 codes (blank means no country filter).
AI_CALLING_TWILIO_FALLBACK_ENABLED=false
AI_CALLING_TWILIO_FALLBACK_COUNTRIES=
LIVEKIT_TWILIO_SIP_OUTBOUND_TRUNK_ID=
TWILIO_VOICE_FROM_NUMBER=

# --- STT Provider (whisper | google | azure) ---
# On Infomaniak the audio endpoint is derived automatically from
# OPENAI_BASE_URL, but it is NOT the same path as the chat endpoint: audio
# lives under /1/ai/<product>/openai, the model is called "whisper" (not
# "whisper-1"), the call is asynchronous, and word timestamps are not offered.
STT_PROVIDER=whisper

# --- Google Cloud STT (optional, if STT_PROVIDER=google) ---
# GOOGLE_STT_API_KEY=
# GOOGLE_STT_PROJECT_ID=

# --- Azure Speech (optional, if STT_PROVIDER=azure) ---
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# ============================================
# Notifications (Module 13)
# ============================================

# --- Push Notifications (OneSignal) ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Notification Webhook Secrets (HMAC verification) ---
NOTIFICATION_EMAIL_WEBHOOK_SECRET=
NOTIFICATION_WHATSAPP_WEBHOOK_SECRET=

# ============================================
# Integrations (Module 14)
# ============================================

# --- Legacy notification-channel adapters (not lead outreach) ---
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
SMS_API_KEY=

# --- Google Calendar OAuth ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:9097/api/v1/users/me/calendar/callback

# --- Business Discovery / Lead Generation Providers ---
# Default discovery is free/open-source: OpenStreetMap + Overpass + Nominatim.
# Public Overpass endpoints can throttle, time out, or temporarily refuse traffic;
# for production reliability, set OVERPASS_API_URL to your own Overpass instance.
# NOMINATIM also reverse-geocodes each lead's coordinates into a real city/country
# (import + the 009 backfill). Keep NOMINATIM_ENABLED=true or leads fall back to
# whatever the source supplied (postal code / blank) instead of a resolved city.
DISCOVERY_PROVIDER_MODE=OPEN_SOURCE_ONLY
OPENSTREETMAP_ENABLED=true
OVERPASS_ENABLED=true
NOMINATIM_ENABLED=true
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Optional comma-separated backup/self-hosted Overpass endpoints. The app tries
# the primary endpoint first, then these, then built-in public fallbacks.
OVERPASS_API_URLS=
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
DISCOVERY_USER_AGENT=UpdataCRM-Discovery/1.0 (+https://updata.local)

# --- Optional Google Maps Platform fallback ---
# Leave these empty for zero Google Places cost. Enable only when you explicitly
# want paid/commercial fallback for better coverage.
# The Google Cloud project needs billing enabled. Enable these APIs:
#   - Places API (New)     nearby/text search and place details (server key)
#   - Geocoding API        resolving typed locations to coordinates (server key)
#   - Maps JavaScript API  map, area drawing and autocomplete in the UI (browser key)
#
# Server key - SECRET. Used only by the API: never sent to the browser, never
# logged, never committed. Restrict it twice in Google Cloud Console: by IP
# address (the API server's outbound IPs) and by API (Places API (New) and
# Geocoding API only).
GOOGLE_PLACES_API_KEY=
# Optional dedicated Geocoding key. Leave empty to reuse GOOGLE_PLACES_API_KEY.
GOOGLE_GEOCODING_API_KEY=
# Browser key - public by design (it ships to the browser), so it MUST be
# restricted by HTTP referrer (e.g. https://app.updata.ai/* and
# http://localhost:3000/*) and by API (Maps JavaScript API only; add Places
# API (New) only if the UI uses client-side Autocomplete). The Next.js client
# uses the same key as NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY in client/.env.local.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_FALLBACK_ENABLED=false
GOOGLE_FALLBACK_MAX_REQUESTS=0

# --- Business Discovery controls (applied per search session) ---
# Preferred number of initial regions (1-5000). Saturated regions are split
# adaptively until the provider no longer returns a full page.
DISCOVERY_MAX_COVERAGE_CELLS=100
# Parallel provider calls per discovery run (1-10).
DISCOVERY_CONCURRENCY=3
# Days a discovery session and its results are kept before automatic deletion
# (1-365). Google limits how long place data may be stored: keep this short.
DISCOVERY_RESULT_TTL_DAYS=60

# --- Website enrichment (responsible scraper for lead contact fields) ---
# Fills MISSING lead email / phone / social links from the lead's own website
# over plain HTTP. robots.txt is honoured and every fetch is bounded.
# Per-request HTTP timeout in ms (1000-60000).
ENRICHMENT_TIMEOUT_MS=8000
# Maximum response size per page in bytes (download aborts beyond this).
ENRICHMENT_MAX_BYTES=1500000
# Parallel sites scraped per bulk enrichment job (1-10).
ENRICHMENT_CONCURRENCY=3
# Honour robots.txt Disallow rules (true in production; set false only for tests).
ENRICHMENT_RESPECT_ROBOTS=true
# Polite, self-identifying User-Agent sent on every enrichment request.
ENRICHMENT_USER_AGENT=UpdataCRM-Enrichment/1.0

# --- Microsoft Outlook Calendar OAuth ---
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:9097/api/v1/users/me/calendar/callback

# --- OCR Service ---
# OCR_PROVIDER=google_document_ai
# OCR_API_KEY=
# OCR_ENDPOINT=

# --- Widget reCAPTCHA ---
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# ============================================
# Legacy / Payment (not used by ERP modules)
# ============================================

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- APK Distribution ---
APK_SERVER_URL=http://179.237.101.32:8005/apk-mb
APK_UPLOAD_SECRET=

# ============================================
# Production Overrides (uncomment for production)
# ============================================
# NODE_ENV=production
# USE_CLUSTER=true
# WORKERS=4
# LOG_LEVEL=warn

# Caller transcription runs separately from the realtime voice model.
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-transcribe
# Blank uses call-language hints; automatic calls detect the spoken language.
OPENAI_REALTIME_TRANSCRIBE_LANGUAGE=
# Optional comma-separated hints for mixed-language calls (e.g. ur,en).
OPENAI_REALTIME_TRANSCRIBE_LANGUAGES=
# Preserve short pauses while callers spell names, email addresses, or numbers.
OPENAI_REALTIME_SILENCE_MS=1000

# ============================================
# Platform governance (see docs/PLATFORM-GOVERNANCE.md)
# ============================================
# Lead visibility: 'company' (default — every lead:read user sees every lead, unchanged
# behaviour) or 'team' (own + assigned + supervised teams' leads; 'lead:read:all' sees all).
LEAD_ACCESS_MODE=company
# Team mode only: opening a lead you do not own requires a stated reason (break-glass grant).
LEAD_ACCESS_REASON_REQUIRED=true
LEAD_ACCESS_GRANT_MINUTES=30
# Mask lead phone/e-mail for users without 'lead:pii:view'. Default false = unchanged behaviour.
PII_MASKING_ENABLED=false
# Multi-tenant isolation is NOT implemented. true makes the server refuse to start.
MULTI_TENANT_MODE=false
# Cost of one SIM SMS for campaign profitability. Blank = "not recorded" (never estimated).
SIM_SMS_COST_PER_MESSAGE=
SIM_SMS_COST_CURRENCY=CHF
