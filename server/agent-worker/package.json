{
  "name": "updata-voice-agent-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LiveKit Agents worker that bridges OpenAI Realtime audio to the Updata CRM AI-calling tool API. Runs as its own process, separate from the API.",
  "main": "src/agent.js",
  "scripts": {
    "start": "node src/agent.js start",
    "dev": "node src/agent.js dev",
    "download-files": "node src/agent.js download-files",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.0",
    "@livekit/agents-plugin-openai": "^1.9.0",
    "@livekit/rtc-node": "^1.1.0",
    "dotenv": "^17.3.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
