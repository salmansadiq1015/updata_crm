# LiveKit Voice Agent worker — environment.
# This process runs SEPARATELY from the CRM API. It needs the same LiveKit
# project as the API and an OpenAI key with Realtime access.

# LiveKit project (same as the API's LIVEKIT_* values)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the API's LIVEKIT_AGENT_NAME so dispatches reach this worker.
LIVEKIT_AGENT_NAME=crm-voice-agent

# OpenAI Realtime
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
PRIMARY_PROVIDER=gemini
PRIMARY_MODEL=gemini-3.8-live
SECONDARY_PROVIDER=openai
SECONDARY_MODEL=gpt-realtime-2.1-mini
GEMINI_FALLBACK_ENABLED=true
GEMINI_API_KEY=
GEMINI_LIVE_VOICE=Puck
GEMINI_EXPERIMENTAL_MODEL=
AI_CALLING_CREDENTIAL_SECRET=
AI_CALLING_MAX_SESSION_SECONDS=300
AI_CALLING_MAX_CALL_COST_USD=0
AI_CALLING_CONNECTION_TIMEOUT_MS=15000
OPENAI_REALTIME_VOICE=alloy
# Written caller transcript (separate from the voice model's audio understanding).
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-transcribe
# Blank uses the call's language as a hint; automatic calls detect the language.
OPENAI_REALTIME_TRANSCRIBE_LANGUAGE=
# Optional comma-separated hints for mixed-language calls, e.g. ur,en or de,fr,en.
OPENAI_REALTIME_TRANSCRIBE_LANGUAGES=
# Allow natural pauses when spelling contact details (200–5000 ms).
OPENAI_REALTIME_SILENCE_MS=1000

# OpenAI output budget and threshold-based context compaction.
# Compaction preserves CRM answers/transcripts and complete recent exchanges.
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=1024
OPENAI_REALTIME_COMPACTION=true
OPENAI_REALTIME_CONTEXT_TOKENS=12000
OPENAI_REALTIME_RECENT_ITEMS=24
OPENAI_REALTIME_COMPACTION_INTERVAL=8

# Fallback only — normally the CRM passes these per-call in the job metadata.
# AGENT_TOOL_API=https://crm.example.com/api/v1/ai-calling/agent

# How long to wait for the callee to pick up (SIP callStatus=active) before
# reporting no_answer and hanging up. The agent never speaks into a ringing line.
AGENT_RING_TIMEOUT_MS=60000

# Health-check HTTP port (default 8081 in production mode). Change it if 8081 is taken (e.g. by Metro).
AGENT_HEALTH_PORT=
