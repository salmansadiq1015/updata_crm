{
  "name": "lead-finder-extension",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "package": "npm run build && rm -f lead-finder-extension.zip && cd dist && zip -qr ../lead-finder-extension.zip .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser-smoke.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
